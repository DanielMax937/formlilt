LLM_PROVIDER=agent-im
AGENT_IM_BASE_URL=http://127.0.0.1:3300/v1
AGENT_IM_API_KEY=agent-im-local
AGENT_IM_MODEL=codex-login/gpt-6-astra
LLM_TIMEOUT_MS=300000
LLM_STRUCTURED_OUTPUT=false
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=
DOUBAO_MODEL=
DOUBAO_THINKING=disabled
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_EXTRACT_PER_DAY=3
# shared requires Redis on Vercel; memory is best-effort per instance only.
RATE_LIMIT_MODE=shared
NEXT_PUBLIC_APP_URL=http://localhost:3050
# Enable in Vercel after turning on Web Analytics for the project.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_CONTACT_URL=

# Public preview: checked-in demos only; no runtime model calls.
NEXT_PUBLIC_DEMO_ONLY=false
# Vercel uses 4400000; self-hosted/local supports 18000000 request bytes.
NEXT_PUBLIC_MAX_REQUEST_BYTES=18000000

# Custom Analytics events require a Vercel Pro-compatible plan.
NEXT_PUBLIC_ENABLE_CUSTOM_EVENTS=false
